# 复制此文件为 .env.local 并填入你的签名身份
# cp .env.local.example .env.local

# 使用 security find-identity -v -p codesigning 查看可用证书
SIGNING_IDENTITY="Apple Development: Your Name (TEAM_ID)"

# App Store Connect API(命令行发 TestFlight 用;私钥放 ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8)
# issuer id 在 ASC 后台 用户和访问 → 集成 → App Store Connect API 里看
ASC_API_KEY_ID="TJL6PZN22A"
ASC_ISSUER_ID=""
